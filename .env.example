# Recoup — copy to .env and fill in real values (never commit .env)
RECOUP_API_KEY=changeme-recoup-api-key-min-32-chars
WEBHOOK_SECRET=changeme-webhook-secret-min-32-chars
CRON_SECRET=changeme-cron-secret-min-32-chars
DATABASE_URL=postgresql://user:password@host:5432/app_db
# Optional: used to fail-closed in production when secrets are missing
# NODE_ENV=production
